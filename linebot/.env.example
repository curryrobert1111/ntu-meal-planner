# 複製成 .env 後填入（.env 不要推上 GitHub）
LINE_CHANNEL_SECRET=在 LINE Developers > Basic settings 找到
LINE_CHANNEL_ACCESS_TOKEN=在 LINE Developers > Messaging API > Channel access token 按 Issue
WEB_URL=https://你的帳號.github.io/ntu-meal-planner/
PORT=3000
# 選填：Gemini 自由對話（見 linebot/GEMINI.md）。不填就只用固定指令
GEMINI_API_KEY=在 Google AI Studio 按 Get API key 產生
# GEMINI_MODEL=gemini-2.5-flash-lite
# AI_DAILY_LIMIT=30
# AI_GLOBAL_LIMIT=1500
